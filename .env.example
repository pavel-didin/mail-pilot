# Copy to .env and fill in. Never commit .env.

# Public URL of this server (https required for Telegram Open letter buttons)
NEXT_PUBLIC_APP_URL=https://mail.example.com

# Telegram — create a bot with @BotFather, then /start it and read your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM — OpenAI-compatible Chat Completions. Used when you Pull next letter / Watch mailbox.
# Leave empty to keep the local rule-based clerk.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Aliases also work:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
