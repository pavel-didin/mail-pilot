# Copy to .env and fill in. Never commit .env.

# Public URL. Prefer https://your-domain (Telegram buttons + TLS).
# Temporary test only: http://203.0.113.10:43147
NEXT_PUBLIC_APP_URL=https://mail.example.com

# Telegram — @BotFather token, then Start the bot and read your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM — OpenAI-compatible Chat Completions. Empty = local rules.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# How often to look for new mail (seconds, minimum 30)
MAIL_POLL_SECONDS=60

# Real mailboxes. If MAIL_1_USER is set, the demo bag is off.
# Gmail: enable 2FA and create an App Password (not your normal password).
MAIL_1_HOST=imap.gmail.com
MAIL_1_PORT=993
MAIL_1_USER=you@gmail.com
MAIL_1_PASS=

MAIL_2_HOST=imap.gmail.com
MAIL_2_PORT=993
MAIL_2_USER=work@gmail.com
MAIL_2_PASS=

# MAIL_3_HOST=imap.mail.ru
# MAIL_3_PORT=993
# MAIL_3_USER=you@mail.ru
# MAIL_3_PASS=
